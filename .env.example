# Environment Variables for Exercise Generator
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_key

# Optional: Database connection settings
# SUPABASE_DB_URL=postgresql://user:password@host:port/database

# --- Seguridad de la API interna (web-service) ---

# Clave secreta que autentica las llamadas server-to-server a /api/user,
# /api/exercises, /api/user/progress, etc. Genera un valor aleatorio largo,
# por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Debe configurarse con EL MISMO VALOR en bot-service y en web-service.
API_SECRET_KEY=genera_un_valor_aleatorio_largo_y_unico

# Orígenes de navegador autorizados a llamar a /api/* vía CORS, separados por
# comas. Déjalo vacío si ningún frontend en el navegador necesita llamar a
# la API directamente (las llamadas servidor-a-servidor no dependen de CORS).
# Ejemplo: ALLOWED_ORIGINS=https://tu-panel-admin.onrender.com
ALLOWED_ORIGINS=
